# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O .env NUNCA vai para o GitHub (está no .gitignore).

# Obrigatório: chave da API do DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=cole_sua_chave_aqui

# Opcional: senha do painel quando ele é acessado pela internet (túnel).
# Quem abre no próprio PC (localhost) ou na rede de casa entra sem senha.
PAINEL_SENHA=

# Opcional: Mercado Livre. Desligado por padrão (o site pede captcha e a API está bloqueada).
ML_ATIVO=0
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://google.com
